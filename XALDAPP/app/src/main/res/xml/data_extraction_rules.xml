<?xml version="1.0" encoding="utf-8"?>
<!--
   Amenaza AM-02 (docs/seguridad/modelo-amenazas.md): los datos financieros del usuario
   no salen del dispositivo por copia de seguridad en la nube ni por transferencia
   a otro dispositivo (Android 12+). En versiones anteriores lo cubre
   android:allowBackup="false" en el AndroidManifest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
