<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fondo_fila"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvIconoPresupuesto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvNombrePresupuesto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/xald_texto"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvPeriodoPresupuesto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_etiqueta"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/xald_texto_secundario"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvConsumoPresupuesto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/xald_texto_secundario"
        android:textSize="13sp" />

    <com.proyecto.xald.ui.BarraProgresoView
        android:id="@+id/barraPresupuesto"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPorcentajePresupuesto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvRestantePresupuesto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/xald_texto_secundario"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
