<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvTituloDialogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Nuevo movimiento"
            android:textColor="@color/xald_texto"
            android:textSize="20sp" />

        <TextView
            style="@style/Xald.EtiquetaCampo"
            android:text="@string/etiqueta_tipo" />

        <include
            android:id="@+id/selectorTipo"
            layout="@layout/selector_tipo" />

        <TextView
            style="@style/Xald.EtiquetaCampo"
            android:text="@string/etiqueta_monto" />

        <EditText
            android:id="@+id/etMonto"
            style="@style/Xald.Campo"
            android:digits="0123456789.,"
            android:fontFamily="sans-serif-medium"
            android:hint="@string/monto_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLength="16"
            android:textSize="22sp" />

        <TextView
            style="@style/Xald.EtiquetaCampo"
            android:text="@string/etiqueta_descripcion" />

        <EditText
            android:id="@+id/etDescripcion"
            style="@style/Xald.Campo"
            android:hint="@string/descripcion_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="60" />

        <LinearLayout
            android:id="@+id/grupoCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Xald.EtiquetaCampo"
                android:text="@string/etiqueta_categoria" />

            <TextView
                android:id="@+id/tvCategoria"
                style="@style/Xald.Campo"
                android:gravity="center_vertical" />
        </LinearLayout>

        <TextView
            style="@style/Xald.EtiquetaCampo"
            android:text="@string/etiqueta_fecha" />

        <TextView
            android:id="@+id/tvFecha"
            style="@style/Xald.Campo"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/tvAvisoFecha"
            style="@style/Xald.Leyenda"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/xald_alerta"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvErrorMovimiento"
            style="@style/Xald.Leyenda"
            android:layout_marginTop="8dp"
            android:textColor="@color/xald_salida"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
