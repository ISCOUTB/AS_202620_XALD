<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fondo_fila"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvIconoCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvNombreCategoria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/xald_texto"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvMontoCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/xald_texto"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvPorcentajeCategoria"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/xald_texto_terciario"
            android:textSize="12sp" />
    </LinearLayout>

    <com.proyecto.xald.ui.BarraProgresoView
        android:id="@+id/barraCategoria"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp" />
</LinearLayout>
