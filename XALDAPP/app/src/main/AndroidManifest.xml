<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Solo se recibe SMS entrante. READ_SMS se eliminó: la app nunca lee la bandeja (minimización, Ley 1581). -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Alertas locales de presupuesto (Android 13+ pide permiso al usuario; se solicita al crear un presupuesto). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Declaración requerida para corregir las alertas del linter de hardware -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- allowBackup en false: la base local contiene datos financieros personales. Va cifrada con
         SQLCipher (ADR-0018) y su llave vive en el Keystore, que no viaja en un respaldo.
         usesCleartextTraffic sale del build type: true solo en debug (backend local por http en
         el emulador); en release es false y todo el tráfico debe ir por https. -->
    <application
        android:name=".XaldApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XALD"
        android:usesCleartextTraffic="${permitirTextoPlano}">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".SmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
