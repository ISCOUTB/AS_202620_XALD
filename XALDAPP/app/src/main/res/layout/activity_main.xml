<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FAFAFA">

    <!-- CABECERA: SALDO TOTAL -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XALD Dashboard"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#212121"/>

    <TextView
        android:id="@+id/tvSaldo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Saldo Total: $0.00"
        android:textSize="22sp"
        android:textColor="#2E7D32"
        android:textStyle="bold" />

    <!-- TARJETA: ESTADO DE SINCRONIZACIÓN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#E3F2FD"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tvPendientes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transacciones pendientes (0)"
            android:textColor="#1565C0"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/btnSincronizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Forzar Sincronización"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- HISTORIAL DE TRANSACCIONES -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Historial Reciente"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#424242"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:elevation="1dp">

        <TextView
            android:id="@+id/tvHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Esperando transacciones..."
            android:textColor="#616161"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"/>
    </ScrollView>

    <!-- BOTÓN DE REFRESCAR PANTALLA -->
    <Button
        android:id="@+id/btnActualizar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Actualizar Pantalla"
        android:backgroundTint="#424242"
        android:textColor="#FFFFFF" />

</LinearLayout>