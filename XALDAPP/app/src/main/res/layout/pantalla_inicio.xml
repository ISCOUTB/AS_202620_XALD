<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollInicio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp">

        <!-- TARJETA FLASH: un dato llamativo del periodo -->
        <LinearLayout
            android:id="@+id/tarjetaFlash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_flash"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvFlashEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="✨"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvFlashTexto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/xald_marca_texto"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- SALDO DISPONIBLE + SEMÁFORO -->
        <LinearLayout
            android:id="@+id/tarjetaSaldo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/fondo_hero"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/saldo_disponible"
                    android:textColor="@color/xald_hero_texto_suave"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/chipSemaforo"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/fondo_pildora_translucida"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp">

                    <com.proyecto.xald.ui.PuntoSemaforoView
                        android:id="@+id/puntoSemaforo"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvSemaforoTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/xald_superficie"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvSaldoDisponible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="$ 0"
                android:textColor="@color/xald_superficie"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/tvSaldoBaseInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/xald_hero_texto_suave"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSemaforoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/xald_hero_detalle"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnAjustarSaldo"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/fondo_pildora_translucida"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/ajustar_saldo"
                android:textColor="@color/xald_superficie"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- SELECTOR DE PERIODO -->
        <LinearLayout
            android:id="@+id/selectorPeriodo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/fondo_segmentos"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/opcionSemana"
                style="@style/Xald.Segmento"
                android:text="@string/periodo_semana" />

            <TextView
                android:id="@+id/opcionMes"
                style="@style/Xald.Segmento"
                android:text="@string/periodo_mes" />

            <TextView
                android:id="@+id/opcionAnio"
                style="@style/Xald.Segmento"
                android:text="@string/periodo_anio" />
        </LinearLayout>

        <!-- ENTRADAS VS. SALIDAS -->
        <LinearLayout style="@style/Xald.Tarjeta">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Xald.TituloSeccion"
                    android:text="@string/titulo_flujo" />

                <TextView
                    android:id="@+id/tvFlujoNeto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.proyecto.xald.ui.BarraFlujoView
                android:id="@+id/barraFlujo"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/puntoEntradas"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/fondo_circulo"
                            android:backgroundTint="@color/xald_entrada" />

                        <TextView
                            style="@style/Xald.Leyenda"
                            android:text="@string/entradas" />

                        <TextView
                            android:id="@+id/tvEntradasPorcentaje"
                            style="@style/Xald.Leyenda"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/xald_texto_terciario" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEntradas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/xald_texto"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/puntoSalidas"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/fondo_circulo"
                            android:backgroundTint="@color/xald_salida" />

                        <TextView
                            style="@style/Xald.Leyenda"
                            android:text="@string/salidas" />

                        <TextView
                            android:id="@+id/tvSalidasPorcentaje"
                            style="@style/Xald.Leyenda"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/xald_texto_terciario" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSalidas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/xald_texto"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- EVOLUCIÓN EN EL TIEMPO -->
        <LinearLayout style="@style/Xald.Tarjeta">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTituloEvolucion"
                    style="@style/Xald.TituloSeccion"
                    android:text="@string/titulo_evolucion" />

                <TextView
                    android:id="@+id/tvMaximoEvolucion"
                    style="@style/Xald.Leyenda"
                    android:textColor="@color/xald_texto_terciario" />
            </LinearLayout>

            <com.proyecto.xald.ui.GraficoBarrasView
                android:id="@+id/graficoEvolucion"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- GASTOS POR CATEGORÍA -->
        <LinearLayout style="@style/Xald.Tarjeta">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Xald.TituloSeccion"
                    android:text="@string/titulo_categorias" />

                <TextView
                    android:id="@+id/tvTotalGastos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/xald_texto"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/listaCategorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvSinGastos"
                style="@style/Xald.Leyenda"
                android:layout_marginTop="10dp"
                android:text="@string/sin_gastos_periodo"
                android:visibility="gone" />
        </LinearLayout>

        <!-- PRESUPUESTOS (vista previa) -->
        <LinearLayout style="@style/Xald.Tarjeta">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Xald.TituloSeccion"
                    android:text="@string/titulo_presupuestos" />

                <TextView
                    android:id="@+id/btnVerPresupuestos"
                    style="@style/Xald.Enlace"
                    android:text="@string/ver_todos" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/listaPresupuestosInicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvSinPresupuestos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/fondo_fila"
                android:lineSpacingExtra="2dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/sin_presupuestos_inicio"
                android:textColor="@color/xald_texto_secundario"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- SINCRONIZACIÓN LOCAL-FIRST -->
        <LinearLayout
            style="@style/Xald.Tarjeta"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEstadoSync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/xald_texto"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvDetalleSync"
                    style="@style/Xald.Leyenda"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSincronizarAhora"
                style="@style/Xald.Enlace"
                android:text="@string/accion_sincronizar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
