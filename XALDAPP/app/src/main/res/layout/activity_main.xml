<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xald_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- BARRA SUPERIOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSaludo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hola 👋"
                    android:textColor="@color/xald_texto_secundario"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTituloPantalla"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Tu dinero"
                    android:textColor="@color/xald_texto"
                    android:textSize="24sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp">

                <ImageButton
                    android:id="@+id/btnSincronizar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/fondo_boton_icono"
                    android:contentDescription="@string/accion_sincronizar"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sincronizar"
                    app:tint="@color/xald_texto" />

                <TextView
                    android:id="@+id/tvInsigniaPendientes"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/fondo_insignia"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="0"
                    android:textColor="@color/xald_superficie"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnPrivacidad"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/fondo_boton_icono"
                android:contentDescription="@string/accion_privacidad"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ojo"
                app:tint="@color/xald_texto" />
        </LinearLayout>

        <!-- PANTALLAS (se muestra una a la vez) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/pantallaInicio"
                layout="@layout/pantalla_inicio" />

            <include
                android:id="@+id/pantallaMovimientos"
                layout="@layout/pantalla_movimientos"
                android:visibility="gone" />

            <include
                android:id="@+id/pantallaPresupuestos"
                layout="@layout/pantalla_presupuestos"
                android:visibility="gone" />
        </FrameLayout>

        <!-- NAVEGACIÓN INFERIOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/fondo_barra_navegacion"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tabInicio"
                style="@style/Xald.Tab">

                <ImageView
                    style="@style/Xald.Tab.Icono"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_inicio" />

                <TextView
                    style="@style/Xald.Tab.Texto"
                    android:text="@string/tab_inicio" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabMovimientos"
                style="@style/Xald.Tab">

                <ImageView
                    style="@style/Xald.Tab.Icono"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_movimientos" />

                <TextView
                    style="@style/Xald.Tab.Texto"
                    android:text="@string/tab_movimientos" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabPresupuestos"
                style="@style/Xald.Tab">

                <ImageView
                    style="@style/Xald.Tab.Icono"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_presupuestos" />

                <TextView
                    style="@style/Xald.Tab.Texto"
                    android:text="@string/tab_presupuestos" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- BOTÓN FLOTANTE: agrega un movimiento (o un presupuesto en esa pestaña) -->
    <ImageButton
        android:id="@+id/fabAgregar"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="80dp"
        android:background="@drawable/fondo_fab"
        android:contentDescription="@string/accion_agregar"
        android:elevation="6dp"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_agregar"
        app:tint="@color/xald_superficie" />
</FrameLayout>
