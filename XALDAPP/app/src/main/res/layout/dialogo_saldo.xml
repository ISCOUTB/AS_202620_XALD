<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="22dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/ajustar_saldo"
        android:textColor="@color/xald_texto"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/saldo_explicacion"
        android:textColor="@color/xald_texto_secundario"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etSaldo"
        style="@style/Xald.Campo"
        android:layout_marginTop="16dp"
        android:digits="0123456789.,-"
        android:fontFamily="sans-serif-medium"
        android:hint="@string/saldo_hint"
        android:importantForAutofill="no"
        android:inputType="numberDecimal|numberSigned"
        android:maxLength="17"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tvSaldoCalculado"
        style="@style/Xald.Leyenda"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvErrorSaldo"
        style="@style/Xald.Leyenda"
        android:layout_marginTop="8dp"
        android:textColor="@color/xald_salida"
        android:visibility="gone" />
</LinearLayout>
